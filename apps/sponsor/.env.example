# src/lib/sui.ts decodes this as hex-encoded bytes of a bech32
# "suiprivkey1..." string, not the bech32 string directly:
#   sui keytool export --key-identity <your-address>
#   node -e "console.log(Buffer.from('PASTE_SUIPRIVKEY_HERE').toString('hex'))"
SPONSOR_PRIVATE_KEY=
SPONSOR_ADDRESS=      # Your sponsor address (public, matches the key above)
NETWORK=testnet
PORT=3000

# Optional overrides — PACKAGE_ID/COIN_TYPE_REGISTRY_ID/PAYMENT_SCHEDULER_ID/
# SUI_RPC_URL are NOT read from env by default; they come from
# @paystreamer/sdk's getConfig(NETWORK). Only set SUI_RPC_URL if you need a
# different RPC endpoint than the SDK's default for this network.
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443
