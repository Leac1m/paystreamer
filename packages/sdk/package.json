{
  "name": "@paystreamer/sdk",
  "version": "0.3.0",
  "description": "PayStreamer SDK for integrating recurring billing on Sui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paystreamer/paystreamer",
    "directory": "packages/sdk"
  },
  "keywords": [
    "sui",
    "paystreamer",
    "subscriptions",
    "recurring-payments",
    "sdk"
  ],
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs"
    },
    "./core/seal": {
      "types": "./dist/core/seal.d.ts",
      "import": "./dist/core/seal.mjs"
    },
    "./core/deepbook": {
      "types": "./dist/core/deepbook.d.ts",
      "import": "./dist/core/deepbook.mjs"
    },
    "./core/walrus": {
      "types": "./dist/core/walrus.d.ts",
      "import": "./dist/core/walrus.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "codegen": "rm -rf src/contracts && sui-ts-codegen generate",
    "build": "tsup src/index.ts src/constants.ts src/core/index.ts src/core/seal.ts src/core/deepbook.ts src/core/walrus.ts src/react/index.ts src/ui/index.ts --format esm --external react --external react-dom --external react/jsx-runtime --external @mysten/dapp-kit-react --external @mysten/sui --external @mysten/seal --external @mysten/deepbook-v3 --external @mysten/walrus --external @tanstack/react-query --no-splitting && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts src/constants.ts src/core/index.ts src/core/seal.ts src/core/deepbook.ts src/core/walrus.ts src/react/index.ts src/ui/index.ts --format esm --watch --external react --external react-dom --external react/jsx-runtime --external @mysten/dapp-kit-react --external @mysten/sui --external @mysten/seal --external @mysten/deepbook-v3 --external @mysten/walrus --external @tanstack/react-query --no-splitting",
    "prepublishOnly": "pnpm build",
    "docs:typedoc": "typedoc",
    "test": "vitest",
    "seed:demo": "tsx scripts/seed-demo-platform.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.562.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@mysten/dapp-kit-react": "^2.1.10",
    "@mysten/deepbook-v3": "^1.6.4",
    "@mysten/seal": "^1.4.0",
    "@mysten/sui": "^2.23.1",
    "@mysten/walrus": "^1.2.14",
    "@tanstack/react-query": "^5.90.16",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mysten/deepbook-v3": {
      "optional": true
    },
    "@mysten/seal": {
      "optional": true
    },
    "@mysten/walrus": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mysten/codegen": "^0.11.1",
    "@mysten/dapp-kit-react": "2.1.10",
    "@mysten/deepbook-v3": "1.6.4",
    "@mysten/seal": "1.4.0",
    "@mysten/sui": "2.23.1",
    "@mysten/walrus": "1.2.14",
    "@tanstack/react-query": "^5.90.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.2.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}
