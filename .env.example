# PayStreamer dev env
# v2 uses a permissionless on-chain scheduler; no SCHEDULER_SECRET needed.

VITE_SPONSOR_API_URL=http://localhost:3000
VITE_SPONSOR_ADDRESS=0x_your_sponsor_address_here

# Scheduler: DeepBook routing is opt-in per platform, per funding currency,
# and off by default. No real DeepBook liquidity pool exists for any
# PayStreamer demo token today, so these are unset in every deployed
# environment — see roadmap.md Phase 3.
# ROUTING_ALLOWLIST_JSON={"0xPLATFORM_ID":{"0xFUNDING_COIN_TYPE":{"poolKey":"SUI_PUSD","isBaseToCoin":true,"deepAmount":"1000000","maxSpend":"2000000000"}}}
# DEEP_COIN_TYPE=0x...::deep::DEEP
